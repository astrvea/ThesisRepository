  m_Script: {fileID: 11500000, guid: 0742edff707f47e47bedcd5db9d92f2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nameText: {fileID: 999940867}
  dialogueText: {fileID: 1846687205}
  portraitImage: {fileID: 679557317}
  lines:
  - characterName: Manny
    line: This memory...
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: It feels vague but...
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: I remember it.
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: I remember her being happy.
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: I want things to go back to how they used to be...
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: What is this memory even showing me...
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  textSpeed: 0.05
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: MelodyMechanic, Assembly-CSharp
        m_MethodName: StartResonance
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
