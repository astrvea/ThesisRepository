--- !u!114 &1112398277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1112398275}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0742edff707f47e47bedcd5db9d92f2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nameText: {fileID: 1509437107}
  dialogueText: {fileID: 1671819447}
  portraitImage: {fileID: 523347618}
  lines:
  - characterName: Quinn
    line: I just wanted to thank you for everything.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: I know it doesn't mean much, but I just wanted you to have some sort of
      closure.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: Closure? You think this is closure?
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: You think what you did to me was closure?
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: I just can't understand how you think like this.
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Quinn
    line: I never meant any of this to happen! I didn't know you would get hurt.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: You didn't know or you didn't care?
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Quinn
    line: ...
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: I'm not here to fight, I'm here to say goodbye.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: Why leave now? What changed?
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Quinn
    line: I... I can't tell you...
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: ...
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Manny
    line: Still your own fight, right?
    portrait: {fileID: 21300000, guid: 89ad93a09726a2c489a2919b941f3da7, type: 3}
  - characterName: Quinn
    line: '*nods*'
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: I need to go now.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: But really, thank you.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: Thank you, and I'm sorry.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: No, I can fix this.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Manny
    line: Just trust me.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  - characterName: Quinn
    line: One last time.
    portrait: {fileID: 21300000, guid: b4e22d863231e714fa5a33255c2f18fe, type: 3}
  textSpeed: 0.05
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1419196678}
        m_TargetAssemblyTypeName: MelodyMechanic, Assembly-CSharp
        m_MethodName: StartResonance
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
